[Unit]
Description=Dedicated HTTPS tunnel for isolated WeChat Work iLink transport
After=network-online.target wechat-work-ilink-transport.service
Wants=network-online.target
Requires=wechat-work-ilink-transport.service

[Service]
Type=simple
User=wechat-work-transport
Group=wechat-work-transport
ExecStart=/usr/local/bin/ngrok http 8792 --domain YOUR_RESERVED_DOMAIN.example.com --config /etc/wechat-work-ilink-transport/ngrok.yml --log stdout --log-format json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
